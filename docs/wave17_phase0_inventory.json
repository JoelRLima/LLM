  "top_level_non_chat_surfaces": ["chat", "run", "doctor", "config", "state", "tools", "extensions", "task", "inspect"],
  "baseline_gaps": [
    "prompt_toolkit is absent from pyproject.toml and the chat loop owns console.input synchronously",
    "AgentApplication.cancel delegates to OrchestratorOperations.cancel_task, which terminalizes and checkpoints",
    "CancellationToken is not thread-safe and has no run-generation request-only seam",
    "interactive /ls, /read and /find call ToolInvocationGateway directly",
    "interactive approval is console.input based and has no broker identity",
    "runtime writers print directly from worker-reachable paths",
    "there is no bounded controller, pending follow-up queue, query executor or attention broker"
  ]
}
