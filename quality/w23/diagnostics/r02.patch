diff --git a/tests/unit/test_current_architecture_performance.py b/tests/unit/test_current_architecture_performance.py
new file mode 100644
index 0000000..34ab235
--- /dev/null
+++ b/tests/unit/test_current_architecture_performance.py
@@ -0,0 +1,47 @@
+"""Focal equivalence/performance guards; no lifecycle or external processes."""
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+from typing import Any
+
+from scripts import check_current_architecture as checker
+
+
+class Source:
+    def __init__(self, code: str) -> None:
+        self.trees = {Path(f"/fixture/consumer{i}.py"): ast.parse(code) for i in range(4)}
+    def module_paths(self) -> dict[str, Path]:
+        return {f"fixture.consumer{i}": path for i,path in enumerate(self.trees)}
+    def tree_for_path(self, path: Path) -> ast.Module:
+        return self.trees[path]
+
+def items() -> list[dict[str, Any]]:
+    return [dict(module=f"fixture.legacy{i}", exports=[dict(name="Thing")],
+                 allowed_production_consumers={},mode="SYMBOL_REEXPORT") for i in range(3)]
+
+def test_compatibility_dynamic_analysis_once_per_ast_per_invocation(monkeypatch: Any) -> None:
+    source=Source("import importlib\nvalue = importlib.import_module('fixture.legacy0')\n")
+    original=checker._dynamic_import_calls
+    calls=[]
+    def counted(tree: ast.Module) -> list[tuple[ast.Call, str]]:
+        calls.append(tree)
+        return original(tree)
+    monkeypatch.setattr(checker,"_dynamic_import_calls",counted)
+    errors=checker._compatibility_consumer_errors(source,items())
+    assert errors and "unauthorized consumers" in errors[0]
+    assert len(calls)==4
+    checker._compatibility_consumer_errors(source,items())
+    assert len(calls)==8
+
+def test_compatibility_cache_does_not_hide_mutated_fixture(monkeypatch: Any) -> None:
+    source=Source("pass\n")
+    assert not checker._compatibility_consumer_errors(source,items())
+    tree=next(iter(source.trees.values()))
+    tree.body[:]=ast.parse("import importlib\nvalue = importlib.import_module('fixture.legacy0')\n").body
+    assert checker._compatibility_consumer_errors(source,items())
+
+def test_compatibility_direct_helper_remains_supported() -> None:
+    tree=ast.parse("import importlib\nx=importlib.import_module('fixture.legacy0')\n")
+    result=checker._compatibility_consumer_file("fixture.consumer",Path("/fixture/consumer.py"),tree,"fixture.legacy0",{"Thing"})
+    assert result==({"Thing"},[])
