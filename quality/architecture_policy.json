  "selector_schema": {
    "module": "exact Python module name",
    "modules": "finite exact module-name set",
    "package_prefix": "exact package/module prefix boundary; matches the prefix itself and dotted descendants",
    "package_prefixes": "finite set of package_prefix selectors",
    "any_of": "logical OR across child selectors",
    "production_module_except": "all production agent modules except the named exact module",
    "exception_semantics": "rule-local exceptions override the enclosing rule only for the exact exception selector"
  },
  "neutral_owner_invariants": [
    "Neutral owners contain data/value contracts or shared mechanics, not application objects.",
    "No neutral owner may accept/store Orchestrator, AgentApplication, generic services: Any, or caller-domain registries.",
    "No neutral owner may add model calls, authority decisions, approval decisions, or caller-specific execution policy."
  ],
  "residual_baseline_dependency_policy": {
    "repo_wide_acyclicity_claimed": false,
    "principle": "W21 converges the explicitly governed critical cycles and modernization seams. Untouched baseline dependencies outside those rules are preserved for behavior/scope control, but do not authorize new sibling cross-package edges.",
    "known_examples_not_assigned_for_elimination_in_w21": [
      {
        "pair": "agent.runtime <-> agent.tools",
        "status": "known residual baseline mutual dependency",
        "reason": "Removing ToolResult/runtime outcome coupling would materially broaden W21 beyond the frozen lane scope; no new runtime/tools edge is authorized."
      },
      {
        "pair": "other members of the baseline package-level SCC",
        "status": "not claimed resolved by W21",
        "reason": "W21 is modernization/convergence, not a repo-wide rewrite."
      }
    ],
    "backlog_rule": "Residual baseline cycles may be addressed by a later dedicated wave; W21 must not worsen them."
  },
  "rules": [
    {
      "rule_id": "W21-R-META-001",
      "edge_class": "forbidden",
      "source": {
        "package_prefix": "agent.tools"
      },
      "destination": {
        "package_prefix": "agent.planning"
      },
      "reason": "Tool runtime must not depend upward on planning metadata/schema ownership.",
      "remediation_lane": "A"
    },
    {
      "rule_id": "W21-R-META-002",
      "edge_class": "forbidden",
      "source": {
        "package_prefix": "agent.tools"
      },
      "destination": {
        "package_prefix": "agent.skills"
      },
      "exceptions": [
        {
          "source_module": "agent.tools.builtin_adapter",
          "destination_package_prefix": "agent.skills",
          "edge_class": "adapter",
          "reason": "BuiltinToolAdapter is the explicit skill-to-tool adaptation boundary."
        }
      ],
      "reason": "Canonical tool contracts cannot import skill-domain contracts; only the explicit builtin adapter may depend on skills.",
      "remediation_lane": "A"
    },
    {
      "rule_id": "W21-R-META-003",
      "edge_class": "forbidden",
      "source": {
        "package_prefix": "agent.planning"
      },
      "destination": {
        "package_prefix": "agent.skills"
      },
      "reason": "Planning consumes neutral operation metadata/projections rather than skill implementation/catalog ownership.",
      "remediation_lane": "A"
    },
    {
      "rule_id": "W21-R-META-004",
      "edge_class": "forbidden",
      "source": {
        "module": "agent.skills.descriptor"
      },
      "destination": {
        "module": "agent.planning.schema_safety"
      },
      "reason": "Shared descriptor schema safety moves to neutral operation metadata ownership.",
      "remediation_lane": "A"
    },
    {
      "rule_id": "W21-R-META-005",
      "edge_class": "forbidden",
      "source": {
        "module": "agent.skills.catalog"
      },
      "destination": {
        "modules": [
          "agent.tools.contracts",
          "agent.tools.provenance"
        ]
      },
      "reason": "Builtin construction metadata must not be authored in terms of tool-runtime metadata contracts.",
      "remediation_lane": "A"
    },
    {
      "rule_id": "W21-R-META-006",
      "edge_class": "forbidden",
      "source": {
        "module": "agent.skills.descriptor"
      },
      "destination": {
        "modules": [
          "agent.tools.contracts",
          "agent.tools.provenance",
          "agent.tools.usage_examples"
        ]
      },
      "reason": "Metadata primitives shared by skills/tools/planning move to the neutral operation owner.",
      "remediation_lane": "A"
    },
    {
      "rule_id": "W21-R-PROC-001",
      "edge_class": "forbidden",
