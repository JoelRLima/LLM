{
  "edge_classes": [
    "canonical",
    "adapter",
    "compatibility",
    "forbidden"
  ],
  "classification_semantics": {
    "rule_local_exception_precedence": "A matching exception embedded in a rule is evaluated before that rule's forbidden classification.",
    "ordered_classification": [
      "rule-local exact exception",
      "exact registered compatibility bridge",
      "exact explicit adapter rule/edge",
      "matching forbidden rule",
      "matching explicit canonical rule",
      "baseline-preserved edge",
      "new-edge policy"
    ],
    "baseline_preserved_edge": "An edge present in the frozen pre-W21 baseline and not governed by a more specific target rule is canonical-for-W21-scope only. This does not authorize new sibling edges. The baseline pair set is closed-world for W21: a new source/destination pair is not baseline-preserved.",
    "new_edge_policy": {
      "same_package": "canonical unless a specific rule forbids it",
      "consumer_to_approved_neutral_owner": "canonical only for the allowed consumer families declared by that neutral owner",
      "explicit_direction": "canonical/adapter only when declared below",
      "all_other_new_cross_package_edges": "forbidden"
    }
  },
  "preserved_canonical_owners": {
    "capability_vocabulary": "agent.capabilities",
    "logical_resource_semantics": "agent.resources.contracts",
    "path_types": "agent.runtime.paths::AppPaths/WorkspacePaths"
  },
  "approved_neutral_owners": [
    {
      "package": "agent.operation",
      "lane": "A",
      "purpose": "Shared operation/builtin metadata value contracts and pure metadata normalization used by skills, tools and planning.",
      "target_modules": [
        "agent.operation.contracts",
        "agent.operation.schema",
        "agent.operation.provenance",
        "agent.operation.usage_examples",
        "agent.operation.spec",
        "agent.operation.catalog",
        "agent.operation.planning_metadata"
      ],
      "allowed_dependency_families": [
        "stdlib",
        "agent.capabilities",
        "agent.resources.contracts",
        "agent.runtime.schema_validation (narrow existing pure schema-validation dependency only)"
      ],
      "must_not_own": [
        "tool invocation execution",
        "skill implementation",
        "planner policy",
        "approval/authority policy"
      ],
      "allowed_consumer_families": [
        "agent.skills",
        "agent.tools",
        "agent.planning",
        "agent.application",
        "agent.orchestration"
      ],
      "runtime_dependency_constraint": "No other agent.runtime dependency is authorized by this owner declaration; if Lane A can move pure schema-shape validation into agent.operation without behavior change, that is preferred."
    },
    {
      "package": "agent.process",
      "lane": "B",
      "purpose": "Shared subprocess lifecycle mechanics only.",
      "target_modules": [
        "agent.process.tree",
        "agent.process.streams",
        "agent.process.lifecycle"
      ],
      "allowed_dependency_families": [
        "stdlib",
        "agent.cancellation"
      ],
      "must_not_own": [
        "shell allowlist/policy",
        "Python AST/code policy",
        "Git authorization/query semantics",
        "stdio protocol semantics",
        "Engineering authorization",
        "validation command policy"
      ],
      "allowed_consumer_families": [
        "agent.skills",
        "agent.tools",
        "agent.code",
        "agent.application_services",
        "agent.engineering"
      ]
    },
    {
      "package": "agent.intent",
      "lane": "D",
      "purpose": "Shared, authority-neutral intent claim value contracts used by parsing and deterministic admission.",
      "target_modules": [
        "agent.intent.claim_types",
        "agent.intent.claim_contracts"
      ],
      "allowed_dependency_families": [
        "stdlib",
        "agent.capabilities",
        "agent.resources.contracts"
      ],
      "must_not_own": [
        "lexical/semantic parsing",
        "model calls",
        "authority admission policy",
        "target grounding policy",
        "clarification routing"
      ],
      "allowed_consumer_families": [
        "agent.interaction",
        "agent.planning",
        "agent.runtime"
      ]
    }
  ],
