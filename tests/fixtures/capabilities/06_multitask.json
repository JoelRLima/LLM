{
  "scenario_id": "multitask_dependency",
  "capability": "multitask",
  "objective": "Analise api.py e model.py independentemente e produza summary.md usando os dois resultados.",
  "initial_files": {
    "api.py": "def get_user(user_id):\n    return user_id\n",
    "model.py": "class User:\n    pass\n",
    "tests/test_summary.py": "from pathlib import Path\n\n\ndef test_summary_mentions_analyzed_modules() -> None:\n    content = Path(\"summary.md\").read_text(encoding=\"utf-8\")\n\n    assert \"api.py\" in content\n    assert \"model.py\" in content\n"
  },
  "expectation": {
    "success": true,
    "files": [{"path": "summary.md", "contains": ["api.py", "model.py"]}],
    "unchanged_files": ["api.py", "model.py", "tests/test_summary.py"],
    "allowed_changed_files": ["summary.md"],
    "max_steps": 10
  },
  "metadata": {
    "execution": {
      "entrypoint": "code_task",
      "skill": "code_task",
      "args": {
        "action": "multitask",
        "graph": {
          "nodes": [
            {
              "id": "analyze_api",
              "objective": "Analise api.py",
              "capabilities": ["read", "analyze"],
              "resources": [{"name": "api.py", "mode": "read"}],
              "metadata": {
                "action": "analyze",
                "targets": ["api.py"]
              }
            },
            {
              "id": "analyze_model",
              "objective": "Analise model.py",
              "capabilities": ["read", "analyze"],
              "resources": [{"name": "model.py", "mode": "read"}],
              "metadata": {
                "action": "analyze",
                "targets": ["model.py"]
              }
            },
            {
              "id": "write_summary",
              "objective": "Produza summary.md com os dois resultados",
              "depends_on": ["analyze_api", "analyze_model"],
              "capabilities": ["read", "write", "process"],
              "resources": [
                {"name": "model", "mode": "write"},
                {"name": "summary.md", "mode": "write"}
              ],
              "metadata": {
                "action": "generate",
                "targets": ["api.py", "model.py"],
                "include_tests": true
              }
            }
          ]
        }
      },
      "model_responses": [
        {
          "changes": [
            {
              "path": "summary.md",
              "kind": "create",
              "content": "# Resumo\n\napi.py expõe get_user.\nmodel.py define User.\n"
            }
          ]
        }
      ],
      "expected_model_calls": 1
    }
  }
}
